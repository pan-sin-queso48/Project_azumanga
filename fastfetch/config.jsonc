{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sakaki_cat.txt",
    "color": {
      "1": "magenta",
      "2": "yellow"
    },
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " 󰮯 ",
    "color": {
      "separator": "38;5;217"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;38;5;217m╭────────── 🌸  Project Azumanga  🌸 ───────────╮\u001b[0m"
    },
    {
      "type": "title",
      "key": "\u001b[1;38;5;217m│\u001b[0m 📝 \u001b[1;33mEstudiante\u001b[0m",
      "format": "{1} \u001b[1;34m@\u001b[0m {2}"
    },
    {
      "type": "os",
      "key": "\u001b[1;38;5;217m│\u001b[0m 🏫 \u001b[1;32mSistema   \u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[1;38;5;217m│\u001b[0m ⚙️ \u001b[1;36mKernel    \u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[1;38;5;217m│\u001b[0m 🎨 \u001b[1;35mEntorno   \u001b[0m"
    },
    {
      "type": "packages",
      "key": "\u001b[1;38;5;217m│\u001b[0m 🎒 \u001b[1;34mMochila   \u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[1;38;5;217m│\u001b[0m 🐚 \u001b[1;33mShell     \u001b[0m"
    },
    {
      "type": "terminal",
      "key": "\u001b[1;38;5;217m│\u001b[0m 📟 \u001b[1;32mTerminal  \u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[1;38;5;217m│\u001b[0m 🧠 \u001b[1;31mMemoria   \u001b[0m"
    },
    {
      "type": "uptime",
      "key": "\u001b[1;38;5;217m│\u001b[0m ⏰ \u001b[1;32mTiempo    \u001b[0m"
    },
    {
      "type": "media",
      "key": "\u001b[1;38;5;217m│\u001b[0m 🎶 \u001b[1;36mMusica    \u001b[0m",
      "format": "{artist} - {title} [{status}]"
    },
    {
      "type": "custom",
      "format": "\u001b[1;38;5;217m╰───────────────────────────────────────────────╯\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m  \u001b[38m  \u001b[39m  \u001b[39m    \u001b[38m  \u001b[37m  \u001b[36m  \u001b[35m  \u001b[34m  \u001b[33m  \u001b[32m  \u001b[31m"
    },
    "break"
  ]
}
